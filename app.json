{
  "expo": {
    "name": "Daliz",
    "slug": "melhorqueontem",
    "owner": "jaraujodevelopers-team",
    "version": "1.0.0",
    "scheme": "daliz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/17a24c56-cd73-4f86-ab68-ab7ffb6ca021"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.melhorqueontem.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.melhorqueontem.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#16233F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": ["SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-background.png",
          "resizeMode": "cover",
          "backgroundColor": "#FBF7F1",
          "dark": {
            "backgroundColor": "#16233F"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#3F6E52"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa sua galeria para você escolher uma foto de perfil.",
          "cameraPermission": "O app usa sua câmera pra você tirar uma foto na hora, quando a ação do dia pede isso."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O app salva na sua galeria as fotos tiradas durante uma ação, pra você poder compartilhar depois.",
          "savePhotosPermission": "O app salva na sua galeria as fotos tiradas durante uma ação, pra você poder compartilhar depois.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O app usa sua localização aproximada para mostrar a cidade e o clima de onde você está agora — nunca guardamos um endereço exato."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9737931606490656~7167414237",
          "iosAppId": "ca-app-pub-9737931606490656~7167414237",
          "userTrackingUsageDescription": "Usamos isso pra mostrar anúncios mais relevantes pra você, e assim manter o app gratuito."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "17a24c56-cd73-4f86-ab68-ab7ffb6ca021"
      }
    }
  }
}
